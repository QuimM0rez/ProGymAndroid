<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/duo_nav_home_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/duo_nav_home_border" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_duo_home_color" />
    </item>
</layer-list>
