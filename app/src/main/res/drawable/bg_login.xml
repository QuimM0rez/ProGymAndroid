<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo oscuro con brillo morado arriba (como el radial-gradient de la web) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/progym_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="420dp"
                android:startColor="#40A855F7"
                android:endColor="#00A855F7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="360dp"
                android:startColor="#2600C3FF"
                android:endColor="#0000C3FF" />
        </shape>
    </item>
</layer-list>
