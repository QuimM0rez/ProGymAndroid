<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    android:orientation="vertical">

    <!-- ===== BARRA SUPERIOR: logo, racha, XP y vidas ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/progym_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/login_logo_desc"
            android:src="@drawable/logo_progym" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fire"
            app:tint="@color/racha_naranja" />

        <TextView
            android:id="@+id/tvRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="18dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/racha_naranja"
            android:textSize="17sp"
            android:text="0" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bolt"
            app:tint="@color/progym_secondary" />

        <TextView
            android:id="@+id/tvXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="18dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/progym_secondary"
            android:textSize="17sp"
            android:text="0" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_heart"
            app:tint="@color/vidas_rojo" />

        <TextView
            android:id="@+id/tvVidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/vidas_rojo"
            android:textSize="17sp"
            android:text="5" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/progym_divider" />

    <!-- ===== RUTA DE ENTRENAMIENTO (camino en zigzag) ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRuta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp" />
</LinearLayout>
