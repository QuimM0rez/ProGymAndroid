<?xml version="1.0" encoding="utf-8"?>
<!-- Cada nivel (botón redondo 3D) de la ruta -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/contenedorNodo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBurbuja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_burbuja"
            android:letterSpacing="0.05"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/progym_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp">

            <!-- Anillo que resalta el nivel actual -->
            <View
                android:id="@+id/vAnillo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <FrameLayout
                android:id="@+id/btnNodo"
                android:layout_width="76dp"
                android:layout_height="72dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/ivIcono"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/progym_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
