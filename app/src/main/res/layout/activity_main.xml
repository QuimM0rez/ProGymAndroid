<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/progym_dark"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- ===== TOP BAR: ESTILO GAMIFICADO PRO GYM ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/progym_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <!-- Bandera de Colombia -->
        <ImageView
            android:id="@+id/ivBandera"
            android:layout_width="36dp"
            android:layout_height="26dp"
            android:contentDescription="Bandera de Colombia"
            android:src="@drawable/ic_flag_colombia" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:text="PRO GYM"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 🔥 Racha de días -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fire"
            app:tint="@color/duo_fire" />

        <TextView
            android:id="@+id/tvRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="sans-serif-black"
            android:text="7"
            android:textColor="@color/duo_fire"
            android:textSize="16sp" />

        <!-- ⚡ Puntos XP -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bolt"
            app:tint="@color/duo_gem" />

        <TextView
            android:id="@+id/tvXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="sans-serif-black"
            android:text="450"
            android:textColor="@color/duo_gem"
            android:textSize="16sp" />

        <!-- ❤️ Energía / Vidas -->
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_heart"
            app:tint="@color/duo_heart" />

        <TextView
            android:id="@+id/tvVidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-black"
            android:text="5"
            android:textColor="@color/duo_heart"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/progym_divider" />

    <!-- ===== CONTENIDO DEL MEDIO: RUTINAS Y RETOS EN CAMINO GAMIFICADO ===== -->
    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingVertical="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- BANNER SECCIÓN: RETO ACTIVO DEL DÍA (De la web de PRO GYM) -->
            <LinearLayout
                android:id="@+id/cardReto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:text="🔥 RETO DEL DÍA"
                        android:textColor="@color/duo_fire"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_duo_speech_bubble"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Coach Quim"
                        android:textColor="@color/progym_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="100 Flexiones + 50 Dominadas"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Supera el récord de la semana para subir a Liga Zafiro"
                    android:textColor="@color/progym_text_muted"
                    android:textSize="13sp" />

                <!-- Barra de progreso del reto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="10dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="65"
                        android:progressTint="@color/progym_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="sans-serif-black"
                        android:text="65%"
                        android:textColor="@color/progym_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TÍTULO: RUTA DE RUTINAS -->
            <TextView
                style="@style/ProGym_Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="NIVEL DE RUTINAS"
                android:textSize="20sp" />

            <!-- CAMINO EN ZIGZAG DE RUTINAS (ESTILO DUOLINGO) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <!-- 1. Rutina Pecho - Completada (Oro 3D) -->
                <LinearLayout
                    android:id="@+id/bloqueRutina1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="-60dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnRutina1"
                        android:layout_width="74dp"
                        android:layout_height="74dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="4dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/duo_gold_check" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pecho &amp; Tríceps"
                        android:textColor="@color/duo_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. Rutina Espalda - Completada (Oro 3D) -->
                <LinearLayout
                    android:id="@+id/bloqueRutina2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bloqueRutina1"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnRutina2"
                        android:layout_width="74dp"
                        android:layout_height="74dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="4dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/duo_gold_check" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Espalda &amp; Bíceps"
                        android:textColor="@color/duo_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- BURBUJA FLOTANTE REBOTANDO: "ENTRENAR AHORA" -->
                <LinearLayout
                    android:id="@+id/contenedorBurbuja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bloqueRutina2"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="-50dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_duo_speech_bubble"
                        android:elevation="4dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="ENTRENAR HOY"
                        android:textColor="@color/progym_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 3. Rutina Piernas - ACTUAL (Morado Neón 3D con mancuerna) -->
                <LinearLayout
                    android:id="@+id/bloqueRutina3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/contenedorBurbuja"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="-50dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnRutina3"
                        android:layout_width="74dp"
                        android:layout_height="74dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="4dp"
                            android:src="@drawable/ic_dumbbell"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Día de Pierna"
                        android:textColor="@color/progym_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. Rutina Hombros - BLOQUEADA (Gris 3D con candado) -->
                <LinearLayout
                    android:id="@+id/bloqueRutina4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bloqueRutina3"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnRutina4"
                        android:layout_width="74dp"
                        android:layout_height="74dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="4dp"
                            android:src="@drawable/ic_duo_lock"
                            app:tint="@color/progym_text_muted" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hombro &amp; Trapecio"
                        android:textColor="@color/progym_text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 5. Examen PRO GYM - BLOQUEADO (Gris 3D) -->
                <LinearLayout
                    android:id="@+id/bloqueRutina5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bloqueRutina4"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnRutina5"
                        android:layout_width="74dp"
                        android:layout_height="74dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="4dp"
                            android:src="@drawable/ic_trophy"
                            app:tint="@color/progym_text_muted" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Desafío Titán"
                        android:textColor="@color/progym_text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>

            <!-- FRASE MOTIVACIONAL AL FINAL (De la página web) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="&quot;El dolor que sientes hoy, es la fuerza que sentirás mañana.&quot;"
                android:textColor="@color/progym_secondary"
                android:textSize="15sp"
                android:textStyle="italic" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/progym_divider" />

    <!-- ===== BARRA INFERIOR DE 6 ÍCONOS ESTILO DUOLINGO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@color/progym_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- 1. Home (Seleccionado) -->
        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_duo_home_selected">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_duo_home_color" />
        </FrameLayout>

        <!-- 2. Tienda de Puntos / Recompensas -->
        <FrameLayout
            android:id="@+id/navTienda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_store"
                app:tint="@color/progym_primary" />
        </FrameLayout>

        <!-- 3. Mancuerna / Rutinas de fuerza -->
        <FrameLayout
            android:id="@+id/navDumbbell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_dumbbell"
                app:tint="@color/progym_secondary" />
        </FrameLayout>

        <!-- 4. Escudo / Ranking Liga -->
        <FrameLayout
            android:id="@+id/navShield"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_duo_shield"
                app:tint="@color/duo_fire" />
        </FrameLayout>

        <!-- 5. Trofeo / Retos cumplidos -->
        <FrameLayout
            android:id="@+id/navTrophy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_trophy"
                app:tint="@color/duo_gold" />
        </FrameLayout>

        <!-- 6. Perfil / Salir -->
        <FrameLayout
            android:id="@+id/navDots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:tint="@color/progym_text_muted" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
