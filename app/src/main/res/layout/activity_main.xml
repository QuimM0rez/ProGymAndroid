<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duo_bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- ===== TOP BAR: ROSA/FUCSIA EXACTO AL DE LA IMAGEN ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/duo_topbar_pink"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <!-- Bandera -->
        <ImageView
            android:id="@+id/ivBandera"
            android:layout_width="36dp"
            android:layout_height="26dp"
            android:contentDescription="Bandera de idioma/curso"
            android:src="@drawable/ic_flag_france" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 🔥 Fuego / Racha 12 -->
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fire"
            app:tint="@color/duo_fire" />

        <TextView
            android:id="@+id/tvRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="sans-serif-black"
            android:text="12"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <!-- 💎 Diamante / Gemas 500 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_duo_gem"
            app:tint="@color/duo_gem" />

        <TextView
            android:id="@+id/tvGemas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="sans-serif-black"
            android:text="500"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <!-- ❤️ Corazón / Vidas 5 -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_heart"
            app:tint="@color/duo_heart" />

        <TextView
            android:id="@+id/tvVidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-black"
            android:text="5"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- ===== CAMINO EN ZIGZAG (Con botón dorado, botón rosa con EMPEZAR y personaje) ===== -->
    <ScrollView
        android:id="@+id/scrollCamino"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingVertical="32dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp">

            <!-- 1. Círculo Dorado 1 (Superior) -->
            <FrameLayout
                android:id="@+id/nodo1"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/duo_gold_check" />
            </FrameLayout>

            <!-- 2. Círculo Dorado 2 -->
            <FrameLayout
                android:id="@+id/nodo2"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_below="@id/nodo1"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="-45dp"
                android:layout_marginTop="22dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/duo_gold_check" />
            </FrameLayout>

            <!-- 3. Círculo Dorado 3 -->
            <FrameLayout
                android:id="@+id/nodo3"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_below="@id/nodo2"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="-90dp"
                android:layout_marginTop="22dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/duo_gold_check" />
            </FrameLayout>

            <!-- PERSONAJE JUGANDO ACOSTADO (Al lado del botón dorado 3 y arriba del botón rosa) -->
            <ImageView
                android:id="@+id/ivPersonaje"
                android:layout_width="160dp"
                android:layout_height="110dp"
                android:layout_alignTop="@id/nodo3"
                android:layout_marginStart="10dp"
                android:layout_marginTop="-15dp"
                android:layout_toEndOf="@id/nodo3"
                android:contentDescription="Personaje Duolingo jugando consola"
                android:src="@drawable/ic_duo_character" />

            <!-- BURBUJA "EMPEZAR" CON FLECHITA ABAJO -->
            <LinearLayout
                android:id="@+id/contenedorBurbuja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/nodo3"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="-60dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmpezar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_duo_speech_bubble"
                    android:elevation="3dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="9dp"
                    android:text="EMPEZAR"
                    android:textColor="@color/duo_speech_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 4. Círculo Rosa Actual (Con ícono de librito abierto) -->
            <FrameLayout
                android:id="@+id/nodo4"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_below="@id/contenedorBurbuja"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="-60dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_book"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- 5. Círculo Gris Bloqueado 1 (Con candado) -->
            <FrameLayout
                android:id="@+id/nodo5"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_below="@id/nodo4"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="-10dp"
                android:layout_marginTop="24dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_duo_lock"
                    app:tint="@color/duo_locked_icon" />
            </FrameLayout>

            <!-- 6. Círculo Gris Bloqueado 2 -->
            <FrameLayout
                android:id="@+id/nodo6"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_below="@id/nodo5"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="40dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_duo_lock"
                    app:tint="@color/duo_locked_icon" />
            </FrameLayout>

        </RelativeLayout>
    </ScrollView>

    <!-- Línea divisoria suave -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/duo_border" />

    <!-- ===== BARRA INFERIOR EXACTA A LA IMAGEN (6 ÍCONOS) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- 1. Home (Casita en caja celeste seleccionada) -->
        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_duo_home_selected" />

        <!-- 2. Audífonos (Morado) -->
        <FrameLayout
            android:id="@+id/navHeadphones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_duo_headphones"
                app:tint="@color/duo_nav_headphones" />
        </FrameLayout>

        <!-- 3. Mancuerna (Celeste brillante) -->
        <FrameLayout
            android:id="@+id/navDumbbell"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_dumbbell"
                app:tint="@color/duo_nav_dumbbell" />
        </FrameLayout>

        <!-- 4. Escudo (Marrón/Ocre) -->
        <FrameLayout
            android:id="@+id/navShield"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_duo_shield"
                app:tint="@color/duo_nav_shield" />
        </FrameLayout>

        <!-- 5. Trofeo (Dorado) -->
        <FrameLayout
            android:id="@+id/navTrophy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_trophy"
                app:tint="@color/duo_nav_trophy" />
        </FrameLayout>

        <!-- 6. Tres puntos (Morado) -->
        <FrameLayout
            android:id="@+id/navDots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_duo_dots"
                app:tint="@color/duo_nav_dots" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
